# macOS
.DS_Store

# --- Python (server/) ---
__pycache__/
*.pyc
.venv/
venv/
server/.env
server/server.log
server/*.log
.coverage

# --- Node / Expo (mobile-app/, web-dashboard/) ---
node_modules/
.expo/
dist/
web-build/
dist-ssr/
*.tsbuildinfo
expo-env.d.ts
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.local

# mobile-app/android IS tracked (hand-maintained native module code lives there),
# but its own build output / local machine config is not.
mobile-app/android/**/build/
mobile-app/android/.gradle/
mobile-app/android/**/.cxx/
mobile-app/android/local.properties
mobile-app/ios/

# Firebase service-account (server-side maxfiy kalit) — repoga tushmasin.
# google-services.json/GoogleService-Info.plist esa mijoz-tomon config (APK ichiga
# baribir qo'shiladi) — EAS build arxivi buni talab qiladi, shuning uchun bu yerda
# istisno QILINMAYDI (avvalroq shu narsa EAS build'ni "fayl topilmadi" bilan buzgan edi).
mobile-app/firebase-service-account.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# --- Android/Gradle (watch app: app/, build.gradle.kts, ...) ---
build/
.gradle/
.cxx/
local.properties
*.apk
*.aab
*.keystore
keystore.properties

# --- ESP32 (PlatformIO) ---
esp32-firmware/.pio/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Yig'ilgan dashboard: deploy paytida web-dashboard/ dan quriladi.
# Manba bilan birga saqlansa, darhol eskiradi va manbadan ishonchliroqdek ko'rinadi.
server/dashboard/

# Tekshiruv skrinshotlari — ishchi fayllar, reponi shishiradi.
design-stitch/*.png
# Manba ikonka va undan chiqarilgan 512px — bular ishchi skrinshot emas, saqlanadi.
!design-stitch/icon-source/
backups_from_server/
*.psd
