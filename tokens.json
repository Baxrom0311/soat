    },
    "attn": {
      "light": "#8A5A00",
      "dark": "#E0A63A"
    },
    "attnSoft": {
      "light": "#8A5A0016",
      "dark": "#E0A63A24",
      "alpha": true
    },
    "ok": {
      "light": "#146B3A",
      "dark": "#3FC97E"
    }
