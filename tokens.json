    "text3": {
      "light": "#6C7679",
      "dark": "#7B8586",
      "minContrastOn": "surface",
      "min": 4.5
    },
    "textDisabled": {
      "light": "#A2A9A9",
      "dark": "#4E5758"
    },
    "accent": {
      "light": "#0C6A62",
      "dark": "#35C9B6"
    },
    "accentHover": {
      "light": "#0A5A54",
      "dark": "#4FD6C4"
    },
    "accentPress": {
      "light": "#095049",
      "dark": "#63DFCE"
    },
    "accentInk": {
      "light": "#FFFFFF",
      "dark": "#04120F"
    },
    "accentSoft": {
      "light": "#0C6A621F",
      "dark": "#35C9B62E",
